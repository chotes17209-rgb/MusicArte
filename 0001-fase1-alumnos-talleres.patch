+        Schema::table('alumnos', function (Blueprint $table) {
+            if (Schema::hasColumn('alumnos', 'direccion')) {
+                $table->dropColumn('direccion');
+            }
+            if (Schema::hasColumn('alumnos', 'edad')) {
+                $table->dropColumn('edad');
+            }
