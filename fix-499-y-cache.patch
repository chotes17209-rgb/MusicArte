-        const url = id ? `/maestros/${id}` : '/maestros';
-        const res = await maFetch(url, {
-            method: id ? 'PUT' : 'POST',
-            headers: { 'Content-Type': 'application/json' },
-            body: JSON.stringify(payload),
-        });
-        if (res && res.ok) {
